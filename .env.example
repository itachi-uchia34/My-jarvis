# Copy to .env and fill in. Never commit .env or share your key.
ANTHROPIC_API_KEY=sk-ant-your-key-here
MODEL=claude-sonnet-5-5
PORT=3000
# Let Jarvis search the web for current facts (uses your API account): true/false
ENABLE_WEB_SEARCH=true
# Optional: require this PIN (sent as x-pin header by the app) so only you can use your server
JARVIS_PIN=
# Several users? Give each their own PIN, comma-separated (overrides JARVIS_PIN):
JARVIS_PINS=
